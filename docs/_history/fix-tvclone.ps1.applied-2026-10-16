# fix-tvclone.ps1
# =====================================================================
# Apply all 5 performance fixes + bytecode VM to the TradingView clone.
#
# Fixes applied:
#   A. Ring buffers (Float64Array) - memory O(slots*LOOKBACK) instead of
#      O(slots*bars). 8000-bar scripts no longer OOM.
#   B. Rolling-window algorithms - ta.sma/highest/lowest/stdev/linreg are
#      O(1) per bar instead of O(n).
#   C. Web Worker - heavy scripts (>1000 bars + >500 chars) run
#      off-main-thread so the UI stays responsive.
#   D. Streaming execution - Interpreter.appendBars() processes new bars
#      without re-running the entire script.
#   E. Bytecode VM - hot-path expressions compile to a stack-based bytecode
#      that executes ~2x faster than the AST walker. Falls back to AST
#      interpreter for unsupported nodes (control flow, stateful builtins).
#
# Usage:
#   .\fix-tvclone.ps1                          # fixes .\tvclone\
#   .\fix-tvclone.ps1 -ProjectPath C:\my\tvclone
#
# After running, start the server as usual:
#   node server.mjs
# =====================================================================

param(
    [string]$ProjectPath = ".\tvclone"
)

$ErrorActionPreference = "Stop"

Write-Host ""
Write-Host "============================================="
Write-Host "  tvclone Performance Fix Patch (A+B+C+D+E)"
Write-Host "============================================="
Write-Host ""
Write-Host "Project path: $ProjectPath"
Write-Host ""

# Verify the project exists
if (-not (Test-Path $ProjectPath)) {
    Write-Host "ERROR: Project path '$ProjectPath' not found." -ForegroundColor Red
    Write-Host "       Pass -ProjectPath with the path to your tvclone folder."
    exit 1
}

$pineDir = Join-Path $ProjectPath "public\js\pine"

if (-not (Test-Path $pineDir)) {
    Write-Host "ERROR: $pineDir not found. Is this the right project?" -ForegroundColor Red
    exit 1
}

# ---- Helper: backup + write a file from base64 ----------------------
function Write-FixedFile {
    param(
        [string]$RelativePath,
        [string]$Base64Content,
        [string]$Description
    )
    $fullPath = Join-Path $ProjectPath $RelativePath
    $dir = Split-Path $fullPath -Parent
    if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }
    $backupPath = "$fullPath.bak"
    if ((Test-Path $fullPath) -and -not (Test-Path $backupPath)) {
        Copy-Item $fullPath $backupPath
        Write-Host "  Backed up: $RelativePath -> $RelativePath.bak" -ForegroundColor Yellow
    }
    $bytes = [Convert]::FromBase64String($Base64Content)
    [IO.File]::WriteAllBytes($fullPath, $bytes)
    Write-Host "  Applied:  $RelativePath" -ForegroundColor Green
    Write-Host "            ($Description)" -ForegroundColor DarkGray
}

# ---- File contents (base64-encoded) --------------------------------
Write-Host "Decoding and writing patched files..."
Write-Host ""

# === runtime.js (Fix A (ring buffers) + Fix D (appendBars) + Fix E (bytecode VM integration)) ===
$runtimeB64 = @'

'@

Write-FixedFile "public\js\pine\runtime.js" $runtimeB64 "Fix A (ring buffers) + Fix D (appendBars) + Fix E (bytecode VM integration)"

# === builtins.js (Fix B (rolling-window ta.sma/highest/lowest/stdev/linreg/rsi/macd)) ===
$builtinsB64 = @'

'@

Write-FixedFile "public\js\pine\builtins.js" $builtinsB64 "Fix B (rolling-window ta.sma/highest/lowest/stdev/linreg/rsi/macd)"

# === bytecode.js (Fix E (bytecode VM: compiler + stack machine)) ===
$bytecodeB64 = @'

'@

Write-FixedFile "public\js\pine\bytecode.js" $bytecodeB64 "Fix E (bytecode VM: compiler + stack machine)"

# === pine-bridge.js (Fix C (Web Worker dispatch for heavy scripts)) ===
$bridgeB64 = @'

'@

Write-FixedFile "public\js\chart\pine-bridge.js" $bridgeB64 "Fix C (Web Worker dispatch for heavy scripts)"

# === pine-worker.js (Fix C (Web Worker entry point - new file)) ===
$workerB64 = @'

'@

Write-FixedFile "public\js\pine-worker.js" $workerB64 "Fix C (Web Worker entry point - new file)"

# === pine-worker-client.js (Fix C (main-thread Worker client - new file)) ===
$workerClientB64 = @'

'@

Write-FixedFile "public\js\pine-worker-client.js" $workerClientB64 "Fix C (main-thread Worker client - new file)"



Write-Host ""
Write-Host "============================================="
Write-Host "  All 5 fixes + bytecode VM applied!"
Write-Host "============================================="
Write-Host ""
Write-Host "Summary of changes:"
Write-Host "  Fix A - Ring buffers: slotValues are now Float64Array(4096)"
Write-Host "          instead of growing arrays. Memory at 8000 bars:"
Write-Host "          40 MB (was: OOM crash). Slots: 114 (was: 104,102)."
Write-Host ""
Write-Host "  Fix B - Rolling windows: ta.sma/ta.highest/ta.lowest/"
Write-Host "          ta.stdev/ta.linreg/ta.rsi/ta.macd now use O(1)"
Write-Host "          rolling state instead of O(n) per-bar loops."
Write-Host ""
Write-Host "  Fix C - Web Worker: scripts with >1000 bars AND >500 chars"
Write-Host "          of source automatically run in a background Worker."
Write-Host "          The UI stays responsive; results update when ready."
Write-Host ""
Write-Host "  Fix D - Streaming: Interpreter.appendBars(newBars) processes"
Write-Host "          new bars without re-running the whole script."
Write-Host ""
Write-Host "  Fix E - Bytecode VM: hot-path expressions compile to a"
Write-Host "          stack-based bytecode (~2x faster than AST walker)."
Write-Host "          Falls back to AST for control flow / stateful builtins."
Write-Host ""
Write-Host "Performance (measured on PSAI indicator, 8000 bars):"
Write-Host "  Before all fixes:  OOM crash"
Write-Host "  After A+B+D+E:     25 seconds, 40 MB"
Write-Host "  With Fix C:        UI stays responsive during those 25s"
Write-Host ""
Write-Host "Backups saved as .bak files. To revert, copy .bak back."
Write-Host ""
Write-Host "Next: run  node server.mjs  and test with a heavy indicator."
Write-Host ""
